NODE_ENV=development
PORT=5000

DB_NAME=wosa
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
# Unix-socket setups (for example Termux): set this instead of DB_HOST
# DB_SOCKET_DIR=/var/run/postgresql

CLIENT_ORIGIN=http://localhost:5173

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_NAME=wosa_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

BCRYPT_ROUNDS=12
DELIVERY_FEE_CENTS=3500

# Payfast: copy these from your Payfast sandbox account
PUBLIC_API_URL=http://localhost:5000
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_CHECK_SOURCE=true
PAYFAST_CONFIRM_WITH_PAYFAST=true